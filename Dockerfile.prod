# Production Dockerfile for Children's Drawing Anomaly Detection System
# Optimized for fast startup and background S3 sync

# ============================================================================
# Stage 1: Build Frontend
# ============================================================================
FROM node:18-alpine AS frontend-build

WORKDIR /frontend

# Copy frontend package files
COPY frontend/package*.json ./

# Install frontend dependencies
RUN npm ci

# Copy frontend source code
COPY frontend/ ./

# Build the React application
RUN npm run build

# ============================================================================
# Stage 2: Python Backend with Fast Startup
# ============================================================================
FROM python:3.11-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/app/.cache/huggingface \
    TRANSFORMERS_CACHE=/app/.cache/huggingface \
    HF_DATASETS_CACHE=/app/.cache/huggingface \
    MPLCONFIGDIR=/app/.cache/matplotlib

# Install system dependencies including AWS CLI
RUN apt-get update && apt-get install -y \
    curl \
    unzip \
    nginx \
    && curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip" \
    && unzip awscliv2.zip \
    && ./aws/install \
    && rm -rf awscliv2.zip aws \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Set work directory
WORKDIR /app

# Copy and install Python dependencies
COPY requirements.txt ./
RUN pip install --upgrade pip && pip install -r requirements.txt

# Copy application code
COPY app/ ./app/
COPY alembic.ini ./
COPY alembic/ ./alembic/
COPY setup.py ./

# Copy frontend build from previous stage
COPY --from=frontend-build /frontend/dist ./frontend_build

# Create required directories with proper permissions
RUN mkdir -p uploads static backups logs .cache/huggingface .cache/matplotlib \
    && mkdir -p static/models static/saliency_maps static/exports static/uploads \
    && chmod -R 755 static uploads \
    && chown -R www-data:www-data static uploads

# Create nginx configuration for static file serving
RUN mkdir -p /etc/nginx/sites-available /etc/nginx/sites-enabled
COPY <<'NGINX_EOF' /etc/nginx/sites-available/default
server {
    listen 80;
    server_name _;
    
    # Increase client max body size for file uploads
    client_max_body_size 50M;
    
    # Serve static files directly with nginx
    location /static/ {
        alias /app/static/;
        expires 1d;
        add_header Cache-Control "public, immutable";
        try_files $uri $uri/ =404;
    }
    
    location /uploads/ {
        alias /app/uploads/;
        expires 1d;
        add_header Cache-Control "public, immutable";
        try_files $uri $uri/ =404;
    }
    
    # Proxy API requests to FastAPI
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_connect_timeout 75s;
    }
    
    # Proxy health checks (including /health/simple for ECS health checks)
    location /health {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    
    location /health/simple {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    
    # Serve React frontend
    location / {
        root /app/frontend_build;
        try_files $uri $uri/ /index.html;
        expires 1h;
        add_header Cache-Control "public";
    }
}
NGINX_EOF

# Link the site configuration
RUN ln -sf /etc/nginx/sites-available/default /etc/nginx/sites-enabled/default \
    && rm -f /etc/nginx/sites-enabled/default

# Create lightweight static file sync script (truly non-blocking)
COPY <<'STATIC_SYNC_EOF' /app/static_sync.sh
#!/bin/bash

echo "🔄 Starting background static file sync (non-blocking)..."

if [ "$APP_ENVIRONMENT" = "production" ]; then
    # Create a completely detached background process
    (
        # Sync only critical ML models first (small, essential files)
        echo "📥 Syncing ML models from S3 (critical)..."
        aws s3 sync s3://children-drawing-production-drawings-921400262514/static/models/ /app/static/models/ --region eu-west-1 --exclude '*.tmp' --exclude '*.log' --quiet
        
        # Set permissions for models
        chmod -R 755 /app/static/models
        chown -R www-data:www-data /app/static/models
        echo "✅ ML models sync completed"
        
        # Sync uploads (medium priority, can be done later)
        echo "📥 Syncing uploads from S3 (background)..."
        aws s3 sync s3://children-drawing-production-drawings-921400262514/uploads/ /app/uploads/ --region eu-west-1 --exclude '*.tmp' --exclude '*.log' --delete --quiet
        chmod -R 755 /app/uploads
        chown -R www-data:www-data /app/uploads
        echo "✅ Uploads sync completed"
        
        # Skip saliency maps sync during startup (too many files, not critical)
        # These will be generated on-demand or synced later
        echo "⏭️  Skipping saliency maps sync during startup (too many files)"
        echo "✅ Background sync process completed"
        
    ) > /tmp/sync.log 2>&1 &
    
    echo "✅ Background sync started (detached process)"
else
    echo "ℹ️  Development mode - skipping S3 sync"
fi
STATIC_SYNC_EOF

RUN chmod +x /app/static_sync.sh

# Create fast startup script (completely non-blocking)
COPY <<'STARTUP_EOF' /app/startup.sh
#!/bin/bash
set -e

echo "🚀 Starting Children's Drawing Anomaly Detection System (Ultra-Fast Startup)"
echo "Environment: $APP_ENVIRONMENT"
echo "Storage Backend: $STORAGE_BACKEND"
echo "AWS Region: $AWS_REGION"

# Start nginx immediately (no dependencies)
echo "🌐 Starting nginx..."
nginx -t && nginx -g "daemon on;"
echo "✅ Nginx started successfully"

# Start background static file sync (completely detached, no waiting)
if [ "$APP_ENVIRONMENT" = "production" ]; then
    echo "🔄 Initiating background static file sync..."
    /app/static_sync.sh
    echo "✅ Background sync initiated (non-blocking)"
else
    echo "ℹ️  Development mode - skipping S3 sync"
fi

# Start FastAPI application immediately (no waiting for anything)
echo "🐍 Starting FastAPI application..."
echo "📊 All background processes will continue independently"
echo "🏥 Health checks available immediately at /health and /health/simple"

exec uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --log-level info --access-log
STARTUP_EOF

RUN chmod +x /app/startup.sh

# Health check with longer timeout
HEALTHCHECK --interval=30s --timeout=10s --start-period=300s --retries=5 \
    CMD curl -f http://localhost:80/health/simple || exit 1

# Expose port 80
EXPOSE 80

# Use fast startup script
CMD ["/app/startup.sh"]
