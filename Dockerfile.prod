# Simplified Production Dockerfile for Children's Drawing Anomaly Detection System
# Single-stage build with minimal complexity to resolve memory exhaustion issues

# ============================================================================
# Stage 1: Build Frontend
# ============================================================================
FROM node:18-alpine AS frontend-build

WORKDIR /frontend

# Copy frontend package files
COPY frontend/package*.json ./

# Install frontend dependencies
RUN npm ci

# Copy frontend source code
COPY frontend/ ./

# Build the React application
RUN npm run build

# ============================================================================
# Stage 2: Simplified Python Backend
# ============================================================================
FROM python:3.11-slim

# Set minimal environment variables (let task definition control APP_ENVIRONMENT and STORAGE_BACKEND)
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/app/.cache/huggingface \
    TRANSFORMERS_CACHE=/app/.cache/huggingface \
    HF_DATASETS_CACHE=/app/.cache/huggingface \
    MPLCONFIGDIR=/app/.cache/matplotlib

# Install minimal system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Set work directory
WORKDIR /app

# Copy and install Python dependencies
COPY requirements.txt ./

RUN pip install --upgrade pip \
    && pip install -r requirements.txt

# Copy application code
COPY app/ ./app/
COPY alembic.ini ./
COPY alembic/ ./alembic/
COPY setup.py ./

# Copy frontend build from previous stage
COPY --from=frontend-build /frontend/dist ./frontend_build

# Create required directories
RUN mkdir -p uploads static backups logs .cache/huggingface .cache/matplotlib \
    && mkdir -p static/models static/saliency_maps static/exports

# DEBUG: Check if database exists in build context BEFORE copy
RUN echo "=== PRE-COPY DEBUG ===" \
    && echo "Checking build context for database file..." \
    && ls -la . | grep -E "(drawings|db)" || echo "No database files found in build context"

# CRITICAL: Copy database file and immediately verify
COPY drawings.db /app/drawings.db

# IMMEDIATE verification after copy using ONLY available commands
RUN echo "=== IMMEDIATE POST-COPY VERIFICATION ===" \
    && echo "Database file after COPY:" \
    && ls -la /app/drawings.db \
    && echo "File size: $(stat -c%s /app/drawings.db) bytes" \
    && echo "Expected: ~373MB (373219328 bytes)" \
    && echo "First 32 bytes of file:" \
    && head -c 32 /app/drawings.db | od -c \
    && chmod 664 /app/drawings.db \
    && echo "=== COPY VERIFICATION COMPLETE ==="

# Extended health check with longer startup grace period - try simple endpoint first
HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=3 \
    CMD curl -f http://localhost:80/health/simple || curl -f http://localhost:80/health || exit 1

# Expose port 80
EXPOSE 80

# Startup with enhanced logging and error handling for debugging
CMD ["sh", "-c", "echo 'Container starting...' && echo 'Environment: APP_ENVIRONMENT='$APP_ENVIRONMENT && echo 'Storage: STORAGE_BACKEND='$STORAGE_BACKEND && echo 'AWS Region: AWS_REGION='$AWS_REGION && echo 'Database file check:' && ls -la /app/drawings.db && echo 'Database size: '$(stat -c%s /app/drawings.db)' bytes' && echo 'Starting uvicorn server...' && uvicorn app.main:app --host 0.0.0.0 --port 80 --workers 1 --log-level info --access-log"]
