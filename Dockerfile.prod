# Simplified Production Dockerfile for Children's Drawing Anomaly Detection System
# Single-stage build with minimal complexity to resolve memory exhaustion issues

# ============================================================================
# Stage 1: Build Frontend
# ============================================================================
FROM node:18-alpine AS frontend-build

WORKDIR /frontend

# Copy frontend package files
COPY frontend/package*.json ./

# Install frontend dependencies
RUN npm ci

# Copy frontend source code
COPY frontend/ ./

# Build the React application
RUN npm run build

# ============================================================================
# Stage 2: Simplified Python Backend
# ============================================================================
FROM python:3.11-slim

# Set minimal environment variables (let task definition control APP_ENVIRONMENT and STORAGE_BACKEND)
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/app/.cache/huggingface \
    TRANSFORMERS_CACHE=/app/.cache/huggingface \
    HF_DATASETS_CACHE=/app/.cache/huggingface \
    MPLCONFIGDIR=/app/.cache/matplotlib

# Install minimal system dependencies including AWS CLI
RUN apt-get update && apt-get install -y \
    curl \
    unzip \
    && curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip" \
    && unzip awscliv2.zip \
    && ./aws/install \
    && rm -rf awscliv2.zip aws \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Set work directory
WORKDIR /app

# Copy and install Python dependencies
COPY requirements.txt ./

RUN pip install --upgrade pip \
    && pip install -r requirements.txt

# Copy application code
COPY app/ ./app/
COPY alembic.ini ./
COPY alembic/ ./alembic/
COPY setup.py ./

# Copy frontend build from previous stage
COPY --from=frontend-build /frontend/dist ./frontend_build

# Create required directories
RUN mkdir -p uploads static backups logs .cache/huggingface .cache/matplotlib \
    && mkdir -p static/models static/saliency_maps static/exports

# Extended health check with longer startup grace period - try simple endpoint first
HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=3 \
    CMD curl -f http://localhost:80/health/simple || curl -f http://localhost:80/health || exit 1

# Expose port 80
EXPOSE 80

CMD ["sh", "-c", "echo 'Container starting...' && echo 'Environment: APP_ENVIRONMENT='$APP_ENVIRONMENT && echo 'Storage: STORAGE_BACKEND='$STORAGE_BACKEND && echo 'AWS Region: AWS_REGION='$AWS_REGION && echo 'Database file check:' && if [ '$APP_ENVIRONMENT' = 'production' ] && [ ! -f '/app/drawings.db' ]; then echo '📥 Downloading database from S3...' && aws s3 cp s3://children-drawing-production-drawings-921400262514/database/drawings.db /app/drawings.db --region eu-west-1 && echo '✅ Database downloaded successfully' && ls -lh /app/drawings.db; else echo '🔧 Database already exists or not in production mode'; fi && echo 'Static files sync:' && if [ '$APP_ENVIRONMENT' = 'production' ]; then echo '📥 Syncing static files from S3...' && aws s3 sync s3://children-drawing-production-drawings-921400262514/static/ /app/static/ --region eu-west-1 --exclude '*.tmp' --exclude '*.log' && echo '📥 Syncing uploads from S3...' && aws s3 sync s3://children-drawing-production-drawings-921400262514/uploads/ /app/uploads/ --region eu-west-1 --exclude '*.tmp' --exclude '*.log' && echo '✅ Static files synced successfully' && echo 'Static files status:' && ls -la /app/static/ && ls -la /app/uploads/; else echo '🔧 Not in production mode, skipping S3 sync'; fi && echo 'Database status:' && ls -la /app/drawings.db 2>/dev/null || echo 'Database file not found' && echo 'Starting uvicorn server...' && uvicorn app.main:app --host 0.0.0.0 --port 80 --workers 1 --log-level info --access-log"]
