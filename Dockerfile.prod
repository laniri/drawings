# Production Dockerfile for Children's Drawing Anomaly Detection System
# Multi-stage build: Frontend + Backend in single container

# ============================================================================
# Stage 1: Build Frontend
# ============================================================================
FROM node:18-alpine AS frontend-build

WORKDIR /frontend

# Copy frontend package files
COPY frontend/package*.json ./

# Install frontend dependencies (including dev dependencies for build)
RUN npm ci --include=dev

# Copy frontend source code
COPY frontend/ ./

# Build the React application
RUN npm run build

# Clean node_modules to avoid platform-specific binaries
RUN rm -rf node_modules

# ============================================================================
# Stage 2: Python Backend with Frontend Assets
# ============================================================================
FROM python:3.11-slim AS base

# Set environment variables for production
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/app/.cache/huggingface \
    TRANSFORMERS_CACHE=/app/.cache/huggingface \
    HF_DATASETS_CACHE=/app/.cache/huggingface \
    MPLCONFIGDIR=/app/.cache/matplotlib

# Install system dependencies including nginx and supervisord
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    libpq-dev \
    nginx \
    supervisor \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create non-root user for security
RUN groupadd -r appuser && useradd -r -g appuser appuser

# Set work directory
WORKDIR /app

# Copy requirements and install Python dependencies
COPY requirements.txt requirements-dev.txt ./
RUN pip install --upgrade pip \
    && pip install -r requirements.txt

# Copy application code
COPY app/ ./app/
COPY alembic.ini ./
COPY alembic/ ./alembic/
COPY setup.py ./

# Create cache directories for Hugging Face and matplotlib
RUN mkdir -p /app/.cache/huggingface /app/.cache/matplotlib && \
    chown -R appuser:appuser /app/.cache

# Pre-download Vision Transformer model to avoid runtime downloads and permission issues
RUN python -c "
import os
os.environ['HF_HOME'] = '/app/.cache/huggingface'
os.environ['TRANSFORMERS_CACHE'] = '/app/.cache/huggingface'
os.environ['MPLCONFIGDIR'] = '/app/.cache/matplotlib'
print('Downloading Vision Transformer model...')
from transformers import ViTImageProcessor, ViTModel
ViTImageProcessor.from_pretrained('google/vit-base-patch16-224')
ViTModel.from_pretrained('google/vit-base-patch16-224')
print('Vision Transformer model downloaded successfully!')
"

# Copy frontend build from previous stage
COPY --from=frontend-build /frontend/dist /var/www/html

# Debug: List contents of frontend build to verify files are present
RUN ls -la /var/www/html/ && echo "Frontend build files copied successfully"

# Create nginx configuration for integrated frontend/backend
COPY <<EOF /etc/nginx/sites-available/default
server {
    listen 80;
    server_name localhost;
    root /var/www/html;
    index index.html;
    
    # Enable gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/xml+rss application/json;
    
    # Proxy API requests to backend (BEFORE root location)
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_connect_timeout 30s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }
    
    # Proxy static file requests to backend
    location /static/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }
    
    # Proxy uploads to backend
    location /uploads/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }
    
    # Proxy auth endpoints to backend
    location /auth/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }
    
    # Proxy demo endpoints to backend
    location /demo/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }
    
    # Proxy health and docs to backend
    location ~ ^/(health|docs|openapi\.json)$ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }
    
    # Serve React app for root and client-side routing (AFTER all proxy locations)
    location / {
        try_files \$uri \$uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
    }
}
EOF

# Create startup script to validate environment and setup
COPY <<EOF /app/startup.sh
#!/bin/bash
set -e

echo "🚀 Starting application setup..."

# Set comprehensive environment defaults
export PYTHONPATH="/app"
export STORAGE_BACKEND="local"
export DATABASE_URL="sqlite:///./drawings.db"
export ENVIRONMENT="production"
export LOG_LEVEL="info"
export SECRET_KEY="production-secret-key-change-in-real-deployment"
export CORS_ORIGINS="*"
export MAX_UPLOAD_SIZE="10485760"
export UPLOAD_DIR="/app/uploads"
export STATIC_DIR="/app/static"
export MODELS_DIR="/app/static/models"
export SALIENCY_DIR="/app/static/saliency_maps"

# Create all required directories with proper permissions
echo "📁 Creating required directories..."
mkdir -p /app/uploads /app/static /app/static/models /app/static/saliency_maps /app/backups /app/logs /app/.cache/huggingface /app/.cache/matplotlib
chown -R appuser:appuser /app/uploads /app/static /app/backups /app/logs /app/.cache
chmod -R 755 /app/uploads /app/static /app/backups /app/logs /app/.cache

# Initialize database if it doesn't exist
echo "🗄️ Initializing database..."
if [ ! -f "/app/drawings.db" ]; then
    echo "Creating new database..."
    touch /app/drawings.db
    chown appuser:appuser /app/drawings.db
    chmod 664 /app/drawings.db
fi

# Test Python imports
echo "🐍 Testing Python imports..."
python -c "
import sys
sys.path.insert(0, '/app')
try:
    from app.main import app
    print('✅ FastAPI app import successful')
except Exception as e:
    print(f'❌ FastAPI app import failed: {e}')
    exit(1)
"

echo "✅ Startup validation complete!"
EOF

# Make startup script executable
RUN chmod +x /app/startup.sh

# Create supervisord configuration with comprehensive logging and startup script
COPY <<EOF /etc/supervisor/conf.d/supervisord.conf
[supervisord]
nodaemon=true
user=root
logfile=/var/log/supervisor/supervisord.log
pidfile=/var/run/supervisord.pid
loglevel=debug

[program:nginx]
command=nginx -g "daemon off;"
autostart=true
autorestart=true
stderr_logfile=/var/log/supervisor/nginx.err.log
stdout_logfile=/var/log/supervisor/nginx.out.log
stderr_logfile_maxbytes=50MB
stdout_logfile_maxbytes=50MB
user=root

[program:startup]
command=/app/startup.sh
autostart=true
autorestart=false
startsecs=0
exitcodes=0
stderr_logfile=/var/log/supervisor/startup.err.log
stdout_logfile=/var/log/supervisor/startup.out.log
user=root
priority=1

[program:uvicorn]
command=uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1 --access-log --log-level info
directory=/app
autostart=true
autorestart=true
stderr_logfile=/var/log/supervisor/uvicorn.err.log
stdout_logfile=/var/log/supervisor/uvicorn.out.log
stderr_logfile_maxbytes=50MB
stdout_logfile_maxbytes=50MB
stderr_capture_maxbytes=50MB
stdout_capture_maxbytes=50MB
user=appuser
priority=10
depends_on=startup
environment=PYTHONPATH="/app",STORAGE_BACKEND="local",DATABASE_URL="sqlite:///./drawings.db",ENVIRONMENT="production",LOG_LEVEL="info",SECRET_KEY="production-secret-key-change-in-real-deployment",CORS_ORIGINS="*",MAX_UPLOAD_SIZE="10485760",UPLOAD_DIR="/app/uploads",STATIC_DIR="/app/static",MODELS_DIR="/app/static/models",SALIENCY_DIR="/app/static/saliency_maps",HF_HOME="/app/.cache/huggingface",TRANSFORMERS_CACHE="/app/.cache/huggingface",HF_DATASETS_CACHE="/app/.cache/huggingface",MPLCONFIGDIR="/app/.cache/matplotlib"
EOF

# Create necessary directories and set permissions
RUN mkdir -p uploads static backups logs /var/log/supervisor /app/.cache/huggingface /app/.cache/matplotlib \
    && mkdir -p static/models static/saliency_maps static/exports \
    && chown -R appuser:appuser /app \
    && chmod -R 755 /app \
    && chown -R www-data:www-data /var/www/html \
    && touch /app/drawings.db \
    && chown appuser:appuser /app/drawings.db \
    && chmod 664 /app/drawings.db

# Health check - check both nginx and backend
HEALTHCHECK --interval=30s --timeout=30s --start-period=60s --retries=5 \
    CMD curl -f http://localhost:80/health || exit 1

# Expose port
EXPOSE 80

# Start supervisord to manage both nginx and uvicorn
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]