# Simplified Production Dockerfile for Children's Drawing Anomaly Detection System
# Single-stage build with minimal complexity to resolve memory exhaustion issues

# ============================================================================
# Stage 1: Build Frontend
# ============================================================================
FROM node:18-alpine AS frontend-build

WORKDIR /frontend

# Copy frontend package files
COPY frontend/package*.json ./

# Install frontend dependencies
RUN npm ci

# Copy frontend source code
COPY frontend/ ./

# Build the React application
RUN npm run build

# ============================================================================
# Stage 2: Simplified Python Backend
# ============================================================================
FROM python:3.11-slim

# Set minimal environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/app/.cache/huggingface \
    TRANSFORMERS_CACHE=/app/.cache/huggingface \
    HF_DATASETS_CACHE=/app/.cache/huggingface \
    MPLCONFIGDIR=/app/.cache/matplotlib

# Install minimal system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Set work directory
WORKDIR /app

# Copy and install Python dependencies
COPY requirements.txt ./
RUN pip install --upgrade pip \
    && pip install -r requirements.txt

# Copy application code
COPY app/ ./app/
COPY alembic.ini ./
COPY alembic/ ./alembic/
COPY setup.py ./

# Copy frontend build from previous stage
COPY --from=frontend-build /frontend/dist ./frontend_build

# Create required directories
RUN mkdir -p uploads static backups logs .cache/huggingface .cache/matplotlib \
    && mkdir -p static/models static/saliency_maps static/exports

# Create database file
RUN touch drawings.db && chmod 664 drawings.db

# Simple health check that doesn't load models
HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
    CMD curl -f http://localhost:80/health || exit 1

# Expose port 80
EXPOSE 80

# Simple startup - just run uvicorn directly
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "80", "--workers", "1"]